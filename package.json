{
  "name": "jialihua-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:videos": "node scripts/prepare-export-videos.mjs",
    "verify:videos": "node scripts/prepare-export-videos.mjs --verify",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4176 --strictPort",
    "check:release": "node scripts/audit-release.mjs",
    "check:pages": "node scripts/audit-release.mjs --artifact=dist-pages",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@testing-library/react": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "vite": "8.3.0"
  }
}
